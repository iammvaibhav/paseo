+    expect(events).toContainEqual(
+      expect.objectContaining({ type: "mode_changed", currentModeId: ACP_ALLOW_ALL_MODE_ID }),
+    );
+
+    const response = await session.requestPermission({
+      sessionId: "session-1",
+      toolCall: {
+        toolCallId: "tool-1",
+        title: "Run command",
+        kind: "execute",
+        status: "pending",
+      },
+      options: [
+        { optionId: "allow-once", name: "Allow", kind: "allow_once" },
