{
  "name": "@getpaseo/client",
  "version": "0.14.0-beta.1",
  "description": "Paseo client SDK package",
  "files": [
    "dist",
    "!dist/**/*.map",
    "README.md"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./internal/daemon-client": {
      "types": "./dist/daemon-client.d.ts",
      "default": "./dist/daemon-client.js"
    },
    "./internal/daemon-client-transport-types": {
      "types": "./dist/daemon-client-transport-types.d.ts",
      "default": "./dist/daemon-client-transport-types.js"
    },
    "./internal/daemon-client-websocket-transport": {
      "types": "./dist/daemon-client-websocket-transport.d.ts",
      "default": "./dist/daemon-client-websocket-transport.js"
    },
    "./node": {
      "types": "./dist/node/index.d.ts",
      "default": "./dist/node/index.js"
    },
    "./internal/hosts": {
      "types": "./dist/hosts/index.d.ts",
      "default": "./dist/hosts/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clean": "node ../../scripts/clean-package-dist.mjs",
    "build": "pnpm --filter @getpaseo/protocol run build && pnpm --filter @getpaseo/relay run build && sh ../../scripts/cpu-slot.sh build tsc -p tsconfig.json --incremental false",
    "build:clean": "pnpm run clean && pnpm run build",
    "prepack": "pnpm run build:clean",
    "typecheck": "sh ../../scripts/cpu-slot.sh typecheck tsgo --noEmit",
    "typecheck:examples": "sh ../../scripts/cpu-slot.sh typecheck tsgo -p tsconfig.examples.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@getpaseo/protocol": "workspace:*",
    "@getpaseo/relay": "workspace:*",
    "ws": "^8.20.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^20.9.0",
    "typescript": "^5.2.2",
    "vitest": "^4.1.6"
  }
}
